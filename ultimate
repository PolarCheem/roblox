local Enabled = false
local legDistance = 1
local Ball = game.workspace.TPSSystem.TPS

local leftleg = game.Players.LocalPlayer.Character["Left Leg"]
local rightleg = game.Players.LocalPlayer.Character["Right Leg"]

function legreach()
	while Enabled do
		task.wait()
		local LeftArmDistance = (Ball.Position - leftleg.Position).Magnitude / 20
		local RightArmDistance = (Ball.Position - rightleg.Position).Magnitude / 20

		if LeftArmDistance <= legDistance then
			firetouchinterest(leftleg, Ball, 0)
			firetouchinterest(leftleg, Ball, 1)
		end
		if RightArmDistance <= legDistance then
			firetouchinterest(rightleg, Ball, 0)
			firetouchinterest(rightleg, Ball, 1)
		end
	end
end

