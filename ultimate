	ImageSource = "Material",
	ShowTitle = true
})

local LegToggle = ReachTab:CreateToggle({
	Name = "Leg Reach",
	Description = nil,
	CurrentValue = false,
	Callback = function(Value)
		Enabled = Value
		if Value then
			legreach()
		end
	end
}, "Toggle")

local LegSlider = ReachTab:CreateSlider({
	Name = "Leg Reach Distance",
	Range = {1, 10},
	Increment = 0.5,
	CurrentValue = 1,
	Callback = function(Value)
		local num = tonumber(Value)
		if num and num > 0 then
			legDistance = num
		end
	end
}, "Slider")





