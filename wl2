-- Auto Farm (original, skips player)
task.spawn(function()
	local antifall
	while task.wait(0.1) do
		pcall(function()
			if not config.Auto.Farm then
				if antifall then antifall:Destroy() antifall = nil end
				return
			end
			local chars = Workspace:FindFirstChild("CharactersAndNPCs")
			if not chars then return end

			local myhrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
			if not myhrp then return end

			local closest, dist = nil, math.huge
			for _, mob in pairs(chars:GetChildren()) do
				if table.find(config.MobNames, mob.Name) then
					local hrp = mob:FindFirstChild("HumanoidRootPart")
					local hum = mob:FindFirstChildOfClass("Humanoid")
					if hrp and hum and hum.Health > 0 then
						local mag = (myhrp.Position - hrp.Position).Magnitude
						if mag < dist then
							dist = mag
							closest = mob
						end
					end
				end
			end

			if closest then
				local hrp = closest:FindFirstChild("HumanoidRootPart")
				if hrp then
					if not antifall then
						antifall = Instance.new("BodyVelocity")
						antifall.Velocity = Vector3.new(0, 0, 0)
						antifall.MaxForce = Vector3.new(9e9, 9e9, 9e9)
						antifall.Parent = myhrp
					end
					myhrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 15)
				end
			elseif antifall then
				antifall:Destroy()
				antifall = nil
			end
		end)
	end
end)

-- Dungeon Farm (updated)
task.spawn(function()
	local antifall
	while task.wait(0.1) do
		pcall(function()
			if not config.Dungeon.Farm then
				if antifall then antifall:Destroy() antifall = nil end
				return
			end

			local chars = Workspace:FindFirstChild("CharactersAndNPCs")
			if not chars then return end
			local myhrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
			if not myhrp then return end

			local waveText = Player.PlayerGui:FindFirstChild("HUD") and Player.PlayerGui.HUD:FindFirstChild("Dungeon") and Player.PlayerGui.HUD.Dungeon:FindFirstChild("Wave") and Player.PlayerGui.HUD.Dungeon.Wave.Text
			local waveNumber = tonumber(waveText and waveText:match("%d+")) or 0

			if waveNumber == 0 and #chars:GetChildren() >= 5 then
				myhrp.CFrame = CFrame.new(-542.355896, 65.6260452, 591.849121, -0.691458941, -0.429156065, 0.581127882, 8.83375328e-09, 0.804423034, 0.594056904, -0.722415745, 0.410765946, -0.556225479)
				return
			end

			local closest, dist = nil, math.huge
			for _, mob in pairs(chars:GetChildren()) do
				if mob ~= Player.Character and not config.Whitelist[mob.Name] then
					local hrp = mob:FindFirstChild("HumanoidRootPart")
					local hum = mob:FindFirstChildOfClass("Humanoid")
					if hrp and hum and hum.Health > 0 then
						local mag = (myhrp.Position - hrp.Position).Magnitude
						if mag < dist then
							dist = mag
							closest = mob
						end
					end
				end
			end

			if closest then
				local hrp = closest:FindFirstChild("HumanoidRootPart")
				if hrp then
					if not antifall then
						antifall = Instance.new("BodyVelocity")
						antifall.Velocity = Vector3.new(0, 0, 0)
						antifall.MaxForce = Vector3.new(9e9, 9e9, 9e9)
						antifall.Parent = myhrp
					end
					local behindPosition = hrp.Position - hrp.CFrame.LookVector * 15
					myhrp.CFrame = CFrame.lookAt(behindPosition, hrp.Position)
				end
			elseif antifall then
				antifall:Destroy()
				antifall = nil
			end
		end)
	end
end)

