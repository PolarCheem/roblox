_G.BallName = "ball"
_G.Magnitude = 8.5
_G.Enabled = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
player.PlayerGui.JumpCooldown:Destroy()
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local pickupHb = character:WaitForChild("pickuphb")

local isPickingUp = false
local ballInstance = nil

local function findBall()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == _G.BallName and obj:IsA("BasePart") then
            ballInstance = obj
            obj.AncestryChanged:Connect(function()
                if not obj.Parent then
                    ballInstance = nil
                    findBall()
                end
            end)
            break
        end
    end
end

findBall()

local function pickupBall(ball)
    if isPickingUp or not ball then return end
    isPickingUp = true
    firetouchinterest(ball, pickupHb, 0)
    task.wait(0.07)
    firetouchinterest(ball, pickupHb, 1)
    isPickingUp = false
end

coroutine.wrap(function()
    while true do
        if character and character:FindFirstChild("Stamina") then
            character.Stamina.Value = 700
        end
        wait(5)
    end
end)()

local connection
connection = RunService.Heartbeat:Connect(function()
    if not _G.Enabled then
        connection:Disconnect()
        return
    end
    if not ballInstance then
        findBall()
        return
    end
    local distance = (ballInstance.Position - humanoidRootPart.Position).Magnitude
    if distance <= _G.Magnitude then
        pickupBall(ballInstance)
    end
end)