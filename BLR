local function predictLanding(velocity, position)
    local acceleration = -workspace.Gravity
    local vy = velocity.Y
    local y0 = position.Y

    local discriminant = vy * vy - 2 * acceleration * y0
    if discriminant < 0 then
        return position
    end

    local timeToLand = (-vy - math.sqrt(discriminant)) / acceleration
    if timeToLand < 0 then
        return position
    end

    local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    return position + horizontalVelocity * timeToLand
end

RunService:BindToRenderStep("VisualizeLandingPosition", Enum.RenderPriority.Camera.Value, function()
    local ball = workspace:FindFirstChild("Football")
    if ball and ball:IsA("BasePart") and ball.Velocity.Magnitude > 1 then
        local landingPosition = predictLanding(ball.Velocity, ball.Position)
        Marker.CFrame = CFrame.new(landingPosition)
        Marker.Transparency = 0.45
    else
        Marker.Transparency = 1
    end
end)
end)

