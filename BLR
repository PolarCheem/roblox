local function updateGKHitbox()
    while true do
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name == "DiveHitbox" then
                        if gkhbe then
                            part.Size = gkhbesize
                        else
                            part.Size = Vector3.new(5, 5, 5)
                        end
                        if gktrans then
                            part.Transparency = gktransparency
                        else
                            part.Transparency = 1
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

